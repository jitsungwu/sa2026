rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 班級文檔（包含 scores 實時聚合）
    match /classes/{classId} {
      allow read: if request.auth.uid != null;
      allow write: if request.auth.uid != null;
    }
    
    // 舉手子集合（按班級分層）
    match /classes/{classId}/hands_raised/{doc} {
      allow read: if request.auth.uid != null;
      allow create, write: if request.auth.uid != null;
      allow delete: if request.auth.uid != null;
    }
    
    // 參與審計日誌（按班級分層，只允許追加）
    match /classes/{classId}/participation_logs/{doc} {
      allow read: if request.auth.uid != null;
      allow create: if request.auth.uid != null;
      allow update, delete: if false;  // 禁止修改和刪除（審計用）
    }
    
    // 舊結構（向後相容，逐步移除）
    match /hands_raised/{doc} {
      allow read: if request.auth.uid != null;
      allow write: if request.auth.uid != null;
    }
    
    match /participation_logs/{doc} {
      allow read: if request.auth.uid != null;
      allow write: if request.auth.uid != null;
    }
    
    // 其他集合
    match /students/{doc} {
      // 允許任何人讀取（登入流程需要驗證帳號）
      allow read: if true;
      // 只允許已登入用戶寫入
      allow write: if request.auth.uid != null;
    }
    
    match /test/{doc} {
      allow read, write: if request.auth.uid != null;
    }
  }
}